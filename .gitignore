###################################################################
###  Globalny .gitignore FitLog (monorepo)                       ###
###  Java / Spring Boot / Gradle / Maven / Angular / Node / Docker ###
###                                                               ###
###  UWAGA: wzorce ze slashem w środku (np. a/b) są kotwiczone do  ###
###  katalogu głównego repo, dlatego używamy **/ dla podprojektów. ###
###################################################################


############################################
### SEKRETY / ZMIENNE ŚRODOWISKOWE       ###
############################################
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

# Klucze i certyfikaty
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.der
id_rsa*
id_ed25519*
secrets/
.secrets/

# Lokalne profile Springa (prod/dev konfiguracja zostaje w repo)
application-local.properties
application-local.yml
application-local.yaml
application-secret*.properties
application-secret*.yml
application-secret*.yaml

# Lokalne nadpisania Dockera
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Claude Code – lokalne ustawienia (współdzielone settings.json zostaje)
.claude/settings.local.json
**/.claude/settings.local.json


############################################
### SYSTEMY OPERACYJNE                   ###
############################################
