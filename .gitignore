##################################
### Globalny .gitignore FitLog ###
##################################

### Zmienne środowiskowe / sekrety ###
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
application-local.properties
application-local.yml

### Pliki systemowe (Mac/Windows/Linux) ###
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp

### Logi ###
*.log
logs/

### IDE ###
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
# Eclipse
.classpath
.project
.settings/
bin/
# VS Code (zostawiamy wspólne ustawienia projektu)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

#############################
### BACKEND (Java/Gradle) ###
#############################

*.class
*.jar
*.war
*.ear
*.nar
!gradle/wrapper/gradle-wrapper.jar
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/
# Lokalna baza H2
*.mv.db
*.trace.db

##################################
### FRONTEND (Angular/Node.js) ###
##################################

node_modules/
.angular/
dist/
out-tsc/
tmp/
coverage/
.sass-cache/
npm-debug.log*
yarn-error.log*
test-report.xml
__screenshots__/
